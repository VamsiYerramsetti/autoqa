# Settings. On the hosting service these are entered in its dashboard, not in a file.
# For running on your own computer, copy this file to ".env" and fill it in.

# Your Anthropic API key. Without it the app runs in practice mode (answers are simple word matches).
ANTHROPIC_API_KEY=

# A Postgres address. With it, accounts, talks and slide pictures survive restarts and deploys.
# Without it, everything is kept in local files (lost on every deploy when hosted).
# DATABASE_URL=postgres://user:password@host/dbname

# The account that may open the numbers page at /admin.
# ADMIN_EMAIL=you@example.com

# Optional
# PORT=4321
# PUBLIC_URL=https://your-domain.example      (the address in the QR code; set automatically on Render)
# AUTOQA_CHAT_MODEL=claude-haiku-5-5          (answers the audience; fast and cheap)
# AUTOQA_PREP_MODEL=claude-sonnet-5-5         (reads the slides and writes the speaker's questions)
